# Gemma Tounsi 1.0 — environment template
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit real tokens, keys, or credentials.
# This file must contain PLACEHOLDERS ONLY (empty values).

# --- Credentials (leave empty here) -----------------------------------------

# Hugging Face access token (needed to fetch the gated Gemma 3 base model).
HF_TOKEN=

# Weights & Biases API key (optional; only if experiment tracking is enabled).
WANDB_API_KEY=

# --- Local paths for large files (kept outside Git) -------------------------
# TODO: confirm these once the Soup environment is validated.

# Hugging Face cache location (models, datasets, tokenizers).
HF_HOME=

# Where training checkpoints / adapters are written.
OUTPUT_DIR=

# --- Experiment tracking (optional) -----------------------------------------

WANDB_PROJECT=
WANDB_ENTITY=
# Set to "offline" to disable network logging, or "disabled" to turn it off.
WANDB_MODE=
